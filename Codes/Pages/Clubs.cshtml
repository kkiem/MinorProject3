@page
@model MinorProject3.Pages.ClubsModel
@{
    ViewData["Title"] = "Clubs Directory";
}

<div class="container mt-4">
    <h2 class="mb-3">🏟️ Premier League Clubs</h2>
    <p class="text-muted">Just looking here! Only admins can change clubs, so head to the Admin tab for that.</p>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Club ID</th>
                <th>Club Name</th>
                <th>City</th>
                <th>Stadium</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ClubsTable != null)
            {
                foreach (System.Data.DataRow row in Model.ClubsTable.Rows)
                {
                    <tr>
                        <td>@row["ClubID"]</td>
                        <td>@row["ClubName"]</td>
                        <td>@row["City"]</td>
                        <td>@row["Stadium"]</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>