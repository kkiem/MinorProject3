@page
@model MinorProject3.Pages.IndexModel
@{
    ViewData["Title"] = "Players Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-3">⚽ Premier League Players</h2>

    <!-- Search Form -->
    <form method="post" asp-page-handler="Search" class="row g-3 mb-4">
        <div class="col-auto">
            <input type="text" asp-for="SearchTerm" class="form-control" placeholder="Search name or position..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-page="./Index" class="btn btn-secondary">Reset</a>
        </div>
    </form>

    <!-- Add Player Form -->
    <div class="card p-3 mb-4 shadow-sm">
        <h5>Add a New Player</h5>
        <form method="post" asp-page-handler="Add" class="row g-3">
            <div class="col-md-3">
                <input type="text" asp-for="FirstName" class="form-control" placeholder="First Name" required />
            </div>
            <div class="col-md-3">
                <input type="text" asp-for="LastName" class="form-control" placeholder="Last Name" required />
            </div>
            <div class="col-md-2">
                <input type="text" asp-for="Position" class="form-control" placeholder="Position" />
            </div>
            <div class="col-md-2">
                <select asp-for="ClubID" class="form-select">
                    <option value="">(no club)</option>
                    @if (Model.ClubsTable != null)
                    {
                        foreach (System.Data.DataRow row in Model.ClubsTable.Rows)
                        {
                            <option value="@row["ClubID"]">@row["ClubName"]</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-success w-100">Add Player</button>
            </div>
        </form>
    </div>

    <!-- Players Table -->
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Position</th>
                <th>Club</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.PlayersTable != null)
            {
                foreach (System.Data.DataRow row in Model.PlayersTable.Rows)
                {
                    <tr>
                        <td>@row["PlayerID"]</td>
                        <td>@row["FirstName"]</td>
                        <td>@row["LastName"]</td>
                        <td>@row["Position"]</td>
                        <td>@(row["ClubName"] == DBNull.Value ? "None" : row["ClubName"])</td>
                        <td>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@row["PlayerID"]" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Really delete this player?');">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>